# Maintainer: Rutytoi220
pkgname=3dfetch
pkgver=0.1.0
pkgrel=1
pkgdesc="Animated 3D fetch tool that spins your distro logo"
arch=('x86_64' 'aarch64')
url="https://github.com/Rutytoi220/3dfetch"
license=('ISC')
depends=('fastfetch')
provides=('3dfetch' 'fetch')
conflicts=('fetch')
options=('!strip' '!emptydir')
source=("$pkgname-$pkgver.tar.gz"::"https://github.com/Rutytoi220/3dfetch/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('071affef13506b5d62d597d09860b52d0a929e6703a42a3f1cc980fc2b0d4def')

build() {
  cd "$pkgname-$pkgver"
  make
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 fetch "$pkgdir/usr/bin/3dfetch"
  install -d "$pkgdir/usr/bin"
  ln -sf 3dfetch "$pkgdir/usr/bin/fetch"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

check() {
  cd "$pkgname-$pkgver"
  "$srcdir/$pkgname-$pkgver/fetch" --version
}
